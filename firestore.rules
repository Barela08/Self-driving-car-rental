rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Reusable Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        request.auth.token.firebase.sign_in_provider == 'custom'
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isMasterAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/master_admins/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() && (
        ((request.auth.token.email == 'nileshbarela08@gmail.com' ||
          request.auth.token.email == 'barelanilesh483@gmail.com' ||
          request.auth.token.email == 'nbgamer126@gmail.com') &&
          request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 3. Validation Helpers
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'accountStatus', 'kycStatus', 'createdAt']) &&
        data.keys().hasOnly([
          'uid', 'displayName', 'role', 'roleId', 'roleName', 'permissions', 'active',
          'branchId', 'branchIds', 'branchScope', 'employeeId', 'designation',
          'joiningDate', 'lastLoginAt', 'mustResetPassword', 'phone', 'email',
          'internalNotes', 'accountStatus', 'kycStatus', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        data.role is string && data.role.size() >= 2 && data.role.size() <= 64 &&
        (!('roleId' in data) || (data.roleId is string && data.roleId.size() <= 128)) &&
        (!('roleName' in data) || (data.roleName is string && data.roleName.size() <= 100)) &&
        (!('permissions' in data) || (data.permissions is list && data.permissions.size() <= 55)) &&
        (!('active' in data) || data.active is bool) &&
        (!('branchId' in data) || (data.branchId is string && data.branchId.size() <= 128)) &&
        (!('branchIds' in data) || (data.branchIds is list && data.branchIds.size() <= 30)) &&
        (!('branchScope' in data) || data.branchScope in ['all', 'assigned']) &&
        (!('employeeId' in data) || (data.employeeId is string && data.employeeId.size() <= 64)) &&
        (!('designation' in data) || (data.designation is string && data.designation.size() <= 100)) &&
        (!('joiningDate' in data) || (data.joiningDate is string && data.joiningDate.size() <= 64)) &&
        (!('lastLoginAt' in data) || (data.lastLoginAt is string && data.lastLoginAt.size() <= 64)) &&
        (!('mustResetPassword' in data) || data.mustResetPassword is bool) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 160)) &&
        (!('internalNotes' in data) || (data.internalNotes is string && data.internalNotes.size() <= 2000)) &&
        data.accountStatus in ['active', 'suspended', 'deletion_requested'] &&
        data.kycStatus in ['Not Started', 'Pending', 'Under Review', 'Verified', 'Rejected', 'Resubmission Required', 'Expired'] &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidPrivateInfo(data) {
      return data.keys().hasAll(['uid', 'marketingConsent', 'serviceConsentVersion', 'updatedAt']) &&
        data.keys().hasOnly([
          'uid', 'email', 'phone', 'phoneVerified', 'phoneVerifiedAt', 'savedAddresses', 'favouriteVehicleIds',
          'marketingConsent', 'whatsappConsent', 'whatsappOptOut', 'fcmTokens',
          'serviceConsentVersion', 'serviceConsentAt', 'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 160)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 24)) &&
        (!('phoneVerified' in data) || data.phoneVerified is bool) &&
        (!('phoneVerifiedAt' in data) || (data.phoneVerifiedAt is string && data.phoneVerifiedAt.size() <= 64)) &&
        (!('savedAddresses' in data) || (data.savedAddresses is list && data.savedAddresses.size() <= 10)) &&
        (!('favouriteVehicleIds' in data) || (data.favouriteVehicleIds is list && data.favouriteVehicleIds.size() <= 50)) &&
        data.marketingConsent is bool &&
        (!('whatsappConsent' in data) || data.whatsappConsent is bool) &&
        (!('whatsappOptOut' in data) || data.whatsappOptOut is bool) &&
        (!('fcmTokens' in data) || (data.fcmTokens is list && data.fcmTokens.size() <= 20)) &&
        data.serviceConsentVersion is string && data.serviceConsentVersion.size() >= 1 && data.serviceConsentVersion.size() <= 32 &&
        (!('serviceConsentAt' in data) || (data.serviceConsentAt is string && data.serviceConsentAt.size() <= 64)) &&
        data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidSupportTicket(data) {
      return data.keys().hasAll(['id', 'userId', 'subject', 'message', 'status', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'bookingId', 'category', 'subject', 'message', 'status', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        data.userId == request.auth.uid &&
        (!('bookingId' in data) || (data.bookingId is string && data.bookingId.size() <= 128)) &&
        (!('category' in data) || (data.category is string && data.category.size() <= 60)) &&
        data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 120 &&
        data.message is string && data.message.size() >= 2 && data.message.size() <= 2000 &&
        data.status in ['Open', 'In Review', 'Resolved', 'Closed'] &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidRoadsideRequest(data) {
      return data.keys().hasAll(['id', 'userId', 'bookingId', 'issueType', 'status', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'bookingId', 'issueType', 'notes', 'lat', 'lng', 'locationShared', 'assignedStaffUid', 'status', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        data.userId == request.auth.uid &&
        isValidId(data.bookingId) &&
        data.issueType is string && data.issueType.size() >= 2 && data.issueType.size() <= 80 &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
        (!('lat' in data) || data.lat is number) &&
        (!('lng' in data) || data.lng is number) &&
        (!('locationShared' in data) || data.locationShared is bool) &&
        (!('assignedStaffUid' in data) || (data.assignedStaffUid is string && data.assignedStaffUid.size() <= 128)) &&
        data.status in ['Open', 'Dispatched', 'In Progress', 'Resolved'] &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // 4. Collection Rules
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isOwner(adminUid) || isAdmin());
      allow list, write: if isAdmin();
    }

    match /auth_credentials/{credId} {
      allow read: if false;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isVerifiedUser() && isValidUserProfile(incoming()) && (
        isAdmin() ||
        (isOwner(userId) &&
          incoming().uid == userId &&
          incoming().role == 'customer' &&
          incoming().accountStatus == 'active' &&
          incoming().kycStatus == 'Not Started')
      );
      allow update: if isValidId(userId) && isVerifiedUser() && isValidUserProfile(incoming()) && (
        isAdmin() ||
        (isOwner(userId) &&
          incoming().uid == existing().uid &&
          incoming().role == existing().role &&
          incoming().kycStatus == existing().kycStatus &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'accountStatus', 'updatedAt']) &&
          incoming().accountStatus in ['active', 'deletion_requested'])
      );
      allow delete: if isAdmin();

      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
        allow list: if isAdmin();
        allow create: if isValidId(userId) && isValidId(docId) && isVerifiedUser() && isValidPrivateInfo(incoming()) && (
          isAdmin() || (isOwner(userId) && incoming().uid == request.auth.uid)
        );
        allow update: if isValidId(userId) && isValidId(docId) && isVerifiedUser() && isValidPrivateInfo(incoming()) && (
          isAdmin() ||
          (isOwner(userId) &&
            incoming().uid == existing().uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'phone', 'savedAddresses', 'favouriteVehicleIds', 'marketingConsent',
              'whatsappConsent', 'whatsappOptOut', 'fcmTokens',
              'serviceConsentVersion', 'serviceConsentAt', 'updatedAt'
            ]))
        );
        allow delete: if isAdmin();
      }
    }

    // Public Service Catalog (Browse without login)
    match /cities/{cityId} {
      allow get: if isValidId(cityId);
      allow list: if true;
      allow write: if isAdmin();
    }

    match /branches/{branchId} {
      allow get: if isValidId(branchId);
      allow list: if true;
      allow write: if isAdmin();
    }

    match /vehicles/{vehicleId} {
      allow get: if isValidId(vehicleId);
      allow list: if true;
      allow write: if isAdmin();
    }

    match /vehicle_private/{vehicleId} {
      allow get: if isValidId(vehicleId) && isAdmin();
      allow list, write: if isAdmin();
    }

    match /insurance_packages/{packageId} {
      allow get: if isValidId(packageId);
      allow list: if true;
      allow write: if isAdmin();
    }

    match /subscription_plans/{planId} {
      allow get: if isValidId(planId);
      allow list: if true;
      allow write: if isAdmin();
    }

    match /company_settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow write: if isAdmin();
    }

    match /coupons/{couponId} {
      allow get: if isValidId(couponId);
      allow list: if true;
      allow write: if isAdmin();
    }

    match /offers/{offerId} {
      allow get: if isValidId(offerId);
      allow list: if true;
      allow write: if isAdmin();
    }

    match /drivers/{driverId} {
      allow get: if isValidId(driverId);
      allow list: if true;
      allow write: if isAdmin();
    }

    // Bookings & Operational Records
    match /bookings/{bookingId} {
      allow get: if isValidId(bookingId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isAdmin();

      match /status_history/{historyId} {
        allow get: if isValidId(bookingId) && isValidId(historyId) && isSignedIn() && (
          get(/databases/$(database)/documents/bookings/$(bookingId)).data.userId == request.auth.uid || isAdmin()
        );
        allow list: if isValidId(bookingId) && isSignedIn() && resource.data.userId == request.auth.uid;
        allow write: if isAdmin();
      }
    }

    match /kyc_verifications/{kycId} {
      allow get: if isValidId(kycId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isAdmin();
    }

    match /payments/{paymentId} {
      allow get: if isValidId(paymentId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isAdmin();
    }

    match /invoices/{invoiceId} {
      allow get: if isValidId(invoiceId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isAdmin();
    }

    match /customer_subscriptions/{subId} {
      allow get: if isValidId(subId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if isValidId(notificationId) && isSignedIn() && (
        isAdmin() ||
        (existing().userId == request.auth.uid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['read']) &&
          incoming().read is bool)
      );
      allow create, delete: if isAdmin();
    }

    match /support_tickets/{ticketId} {
      allow get: if isValidId(ticketId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(ticketId) && isVerifiedUser() &&
        isValidSupportTicket(incoming()) &&
        incoming().id == ticketId &&
        incoming().status == 'Open';
      allow update, delete: if isAdmin();
    }

    match /roadside_requests/{ticketId} {
      allow get: if isValidId(ticketId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(ticketId) && isVerifiedUser() &&
        isValidRoadsideRequest(incoming()) &&
        incoming().id == ticketId &&
        incoming().status == 'Open';
      allow update, delete: if isAdmin();
    }

    // WhatsApp Business Integration & Payment Proof Collections
    match /whatsapp_config/{configId} {
      allow get: if isValidId(configId) && isAdmin();
      allow list, write: if isAdmin();
    }

    match /whatsapp_templates/{templateId} {
      allow get: if isValidId(templateId) && isAdmin();
      allow list, write: if isAdmin();
    }

    match /employee_notification_settings/{settingId} {
      allow get: if isValidId(settingId) && isAdmin();
      allow list, write: if isAdmin();
    }

    match /notification_logs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list, write: if isAdmin();
    }

    match /payment_proofs/{proofId} {
      allow get: if isValidId(proofId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isAdmin();
    }

    match /payment_audit_logs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list, write: if isAdmin();
    }

    match /whatsapp_webhook_events/{eventId} {
      allow get: if isValidId(eventId) && isAdmin();
      allow list: if isAdmin();
      allow write: if false;
    }

    // Never expose OTP hashes or challenges to client Firestore reads or writes
    match /whatsapp_otp_challenges/{challengeId} {
      allow read, write: if false;
    }

    // Owner Admin Control Center operational collections
    match /notification_campaigns/{campaignId} {
      allow get: if isValidId(campaignId) && isAdmin();
      allow list, write: if isAdmin();
    }

    match /admin_notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isAdmin();
      allow list, write: if isAdmin();
    }

    match /contact_enquiries/{enquiryId} {
      allow get: if isValidId(enquiryId) && isAdmin();
      allow list, write: if isAdmin();
    }

    match /email_fallbacks/{fallbackId} {
      allow get: if isValidId(fallbackId) && isAdmin();
      allow list: if isAdmin();
      allow write: if false;
    }

    match /roles/{roleId} {
      allow get: if isValidId(roleId) && isAdmin();
      allow list, write: if isAdmin();
    }

    match /vehicle_maintenance/{maintenanceId} {
      allow get: if isValidId(maintenanceId) && isAdmin();
      allow list, write: if isAdmin();
    }

    match /refunds/{refundId} {
      allow get: if isValidId(refundId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isAdmin();
    }

    match /staff_login_history/{entryId} {
      allow get: if isValidId(entryId) && isAdmin();
      allow list, write: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list, write: if isAdmin();
    }

    match /integrations_checks/{checkId} {
      allow get: if isValidId(checkId) && isAdmin();
      allow list: if isAdmin();
      allow write: if false;
    }

    match /inventory_holds/{holdId} {
      allow get: if isValidId(holdId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isAdmin();
    }

    match /booking_vehicle_assignments/{assignmentId} {
      allow get: if isValidId(assignmentId) && isAdmin();
      allow list, write: if isAdmin();
    }

    // Never expose raw payment screenshots to direct client reads or writes
    match /payment_screenshots/{proofId} {
      allow read, write: if false;
    }

    match /company_assets/{assetId} {
      allow read, write: if false;
    }

    match /rental_agreements/{agreementId} {
      allow get: if isValidId(agreementId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isAdmin();
    }

    match /customer_reviews/{reviewId} {
      allow get: if isValidId(reviewId) && (existing().status == 'Approved' || isOwner(existing().userId) || isAdmin());
      allow list: if resource.data.status == 'Approved' || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    // Master Admin Platform & AI / Auth-OTP collections
    match /master_admins/{masterUid} {
      allow get: if isValidId(masterUid) && (isOwner(masterUid) || isMasterAdmin() || isAdmin());
      allow list, write: if isAdmin();
    }

    match /platform_tenants/{tenantId} {
      allow get: if isValidId(tenantId) && (isMasterAdmin() || isAdmin());
      allow list, write: if isAdmin();
    }

    match /auth_otp_config/{configId} {
      allow get: if isValidId(configId) && (isMasterAdmin() || isAdmin());
      allow list, write: if isAdmin();
    }

    match /otp_verification_logs/{logId} {
      allow get: if isValidId(logId) && (isMasterAdmin() || isAdmin());
      allow list, write: if isAdmin();
    }

    match /ai_config/{configId} {
      allow get: if isValidId(configId) && (isMasterAdmin() || isAdmin());
      allow list, write: if isAdmin();
    }

    match /ai_usage_logs/{logId} {
      allow get: if isValidId(logId) && (isMasterAdmin() || isAdmin());
      allow list, write: if isAdmin();
    }

    // Normalized Master Prompt Business, Inventory, KYC Document, and Governance Collections
    match /businesses/{businessId} {
      allow get: if isValidId(businessId);
      allow list: if true;
      allow write: if isAdmin();
    }

    match /websiteSettings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow write: if isAdmin();
    }

    match /socialLinks/{linkId} {
      allow get: if isValidId(linkId);
      allow list: if true;
      allow write: if isAdmin();
    }

    match /vehicleModels/{modelId} {
      allow get: if isValidId(modelId);
      allow list: if true;
      allow write: if isAdmin();
    }

    match /vehicleCategories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if true;
      allow write: if isAdmin();
    }

    match /inventory/{unitId} {
      allow get: if isValidId(unitId) && isAdmin();
      allow list, write: if isAdmin();
    }

    match /owners/{ownerId} {
      allow get: if isValidId(ownerId) && (isOwner(ownerId) || isAdmin());
      allow list, write: if isAdmin();
    }

    match /staff/{staffId} {
      allow get: if isValidId(staffId) && (isOwner(staffId) || isAdmin());
      allow list, write: if isAdmin();
    }

    match /customers/{customerId} {
      allow get: if isValidId(customerId) && (isOwner(customerId) || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /permissions/{permissionId} {
      allow get: if isValidId(permissionId) && isAdmin();
      allow list, write: if isAdmin();
    }

    match /customerDocuments/{docId} {
      allow get: if isValidId(docId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isAdmin();
    }

    // Never expose raw private KYC file bytes to direct client Firestore reads or writes
    match /kyc_document_blobs/{docId} {
      allow read, write: if false;
    }

    match /consent_records/{consentId} {
      allow get: if isValidId(consentId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isAdmin();
    }

    match /maintenance/{maintenanceId} {
      allow get: if isValidId(maintenanceId) && isAdmin();
      allow list, write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list, create, update: if isAdmin();
      allow delete: if false;
    }

    match /seed_markers/{markerId} {
      allow get: if isValidId(markerId) && isAdmin();
      allow list, write: if isAdmin();
    }

    match /systemSettings/{settingId} {
      allow get: if isValidId(settingId) && isAdmin();
      allow list, write: if isAdmin();
    }

    match /aiSettings/{settingId} {
      allow get: if isValidId(settingId) && (isMasterAdmin() || isAdmin());
      allow list, write: if isAdmin();
    }

    match /migrationJobs/{jobId} {
      allow get: if isValidId(jobId) && isAdmin();
      allow list, write: if isAdmin();
    }
  }
}
