# GEMINI_API_KEY: Required for server-side Gemini features if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Automatically injected by AI Studio runtime.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Provisioned by AI Studio Google Maps setup.
# Restrict HTTP referrers and designated APIs in Google Cloud Console before production.
VITE_GOOGLE_MAPS_API_KEY=""

# Payment Gateway (Razorpay India) - Configure server-side keys in Secrets for live checkout.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Push Notifications (Firebase Cloud Messaging VAPID key for web push)
VITE_FCM_VAPID_KEY=""
