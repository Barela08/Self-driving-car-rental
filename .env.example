# GEMINI_API_KEY: Required for server-side Gemini features if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Automatically injected by AI Studio runtime.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Provisioned by AI Studio Google Maps setup.
# Restrict HTTP referrers and designated APIs in Google Cloud Console before production.
VITE_GOOGLE_MAPS_API_KEY=""

# Company QR / UPI Payment Receiving Details (No third-party gateway required)
COMPANY_UPI_ID=""
COMPANY_UPI_NAME="EliteDrive Mobility"

# Meta WhatsApp Cloud API & Google Cloud Secret Manager (Never expose in VITE_ vars)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WABA_ID=""
WHATSAPP_BUSINESS_PHONE=""

# Push Notifications (Firebase Cloud Messaging VAPID key for web push)
VITE_FCM_VAPID_KEY=""
