        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "uid", "role", "outcome", "timestamp"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Enterprise RBAC, permission denial, KYC inspection, and settings audit log",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "actorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "action": { "type": "string", "maxLength": 120 },
        "targetId": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "actorUid", "action", "targetId", "timestamp"]
    },
    "IntegrationCheck": {
      "title": "IntegrationCheck",
      "description": "Sanitized connectivity health check metadata for external services (no secrets)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "provider": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "maxLength": 40 },
        "checkedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "provider", "status", "checkedAt"]
    },
    "InventoryHold": {
      "title": "InventoryHold",
      "description": "Temporary booking inventory hold with automatic expiration",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "bookingId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "vehicleIds": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["Active", "Converted", "Expired", "Released"] },
        "expiresAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "bookingId", "userId", "vehicleIds", "status", "expiresAt", "createdAt"]
    },
    "BookingVehicleAssignment": {
      "title": "BookingVehicleAssignment",
      "description": "Physical unit assignment linking a booking to specific fleet registration IDs",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "bookingId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "vehicleId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "registrationNumber": { "type": "string", "maxLength": 40 },
        "branchId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["Reserved", "Active", "Completed", "Released"] }
      },
      "required": ["id", "bookingId", "vehicleId", "status"]
    },
    "PaymentScreenshot": {
      "title": "PaymentScreenshot",
      "description": "Server-only private storage for customer UPI payment screenshots",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "bookingId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "mimeType": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "bookingId", "userId", "createdAt"]
    },
    "RentalAgreement": {
      "title": "RentalAgreement",
      "description": "Timestamped customer self-drive rental agreement acceptance record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "bookingId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "maxLength": 32 },
        "acceptedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "bookingId", "userId", "version", "acceptedAt"]
    },
    "CustomerReview": {
      "title": "CustomerReview",
      "description": "Verified customer trip review subject to admin moderation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "bookingId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "vehicleId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "rating": { "type": "number" },
        "status": { "type": "string", "enum": ["Pending Moderation", "Approved", "Rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "bookingId", "vehicleId", "userId", "rating", "status", "createdAt"]
    },
    "PlatformTenant": {
      "title": "PlatformTenant",
      "description": "Master Admin tenant configuration and feature flags",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "businessName": { "type": "string", "maxLength": 120 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["active", "suspended"] }
      },
      "required": ["id", "businessName", "ownerUid", "status"]
    },
    "AuthOtpConfig": {
      "title": "AuthOtpConfig",
      "description": "Auth, Firebase Phone Auth, and non-production Demo OTP authorization controls",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "demoOtpEnabled": { "type": "boolean" },
        "firebasePhoneAuthEnabled": { "type": "boolean" },
        "whatsappOtpEnabled": { "type": "boolean" }
      },
      "required": ["id", "demoOtpEnabled", "firebasePhoneAuthEnabled", "whatsappOtpEnabled"]
    },
    "OtpVerificationLog": {
      "title": "OtpVerificationLog",
      "description": "Audit log of OTP and Firebase Phone verification events (never stores plaintext OTPs)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 24 },
        "channel": { "type": "string", "enum": ["demo_otp", "firebase_phone", "whatsapp"] },
        "status": { "type": "string", "enum": ["sent", "verified", "failed", "expired"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "phone", "channel", "status", "createdAt"]
    },
    "AiConfig": {
      "title": "AiConfig",
      "description": "Server-side Gemini Concierge Assistant configuration (no secrets stored)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "enabled": { "type": "boolean" },
        "bookingEnabled": { "type": "boolean" },
        "modelName": { "type": "string", "maxLength": 80 }
      },
      "required": ["id", "enabled", "bookingEnabled", "modelName"]
    },
    "AiUsageLog": {
      "title": "AiUsageLog",
      "description": "Telemetry and fallback audit log for AI concierge queries",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "language": { "type": "string", "enum": ["en", "hi", "mr"] },
        "status": { "type": "string", "enum": ["success", "fallback", "error"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "language", "status", "createdAt"]
    }
  },
